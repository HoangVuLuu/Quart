<Project Sdk="Microsoft.NET.Sdk">
  <!-- In-app, email and push notifications, the outbox, bundling. Starts in M2.
       A module owns its own database schema and exposes only what its public NotificationsModule class exposes.
       It may reference Quart.SharedKernel, never another module (enforced by Quart.ArchitectureTests). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Quart.SharedKernel\Quart.SharedKernel.csproj" />
  </ItemGroup>
</Project>
