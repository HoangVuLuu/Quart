<Project Sdk="Microsoft.NET.Sdk">
  <!-- Types every module may use. Keep it small: if something here only serves one module, it belongs in that module. -->
  <ItemGroup>
    <!-- The workplace guard (AD-026, AD-042) is an endpoint filter every module puts on its routes. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- Time is NodaTime everywhere (AD-028), including in the contracts modules share. -->
    <PackageReference Include="NodaTime" />
    <!-- Only for the shared snake_case naming helper (decision 0011): no module gets a database from here. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>
</Project>
