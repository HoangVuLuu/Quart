<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- xUnit.net v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CsCheck" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <!-- The lab's Presotea sample, so tests can run the generator on the scenario the lab shows. -->
    <None Include="..\..\src\backend\Modules\Quart.Modules.Scheduling\Lab\Scenarios\presotea.json" Link="Scenarios\presotea.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\backend\Quart.Generator\Quart.Generator.csproj" />
  </ItemGroup>
</Project>
