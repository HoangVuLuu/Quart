<Project Sdk="Microsoft.NET.Sdk">
  <!-- The scheduled-job table and the tick endpoint that runs whatever is due (AD-029). Starts in M2.
       A module owns its own database schema and exposes only what its public JobsModule class exposes.
       It may reference Quart.SharedKernel, never another module (enforced by Quart.ArchitectureTests). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Quart.SharedKernel\Quart.SharedKernel.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Npgsql's provider asks for EF Core 10.0.4 while the Design package wants 10.0.12; naming the
         newer one here resolves the version conflict warning (an error in CI). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NodaTime" />
  </ItemGroup>
</Project>
