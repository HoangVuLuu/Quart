<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- The single ASP.NET Core host (AD-020). It wires modules together, serves the API under /api,
       and in production also serves the built React app from wwwroot (copied in by the Dockerfile). -->
  <PropertyGroup>
    <UserSecretsId>quart-api</UserSecretsId>
    <!-- Every build writes the OpenAPI description to src/web/openapi/quart.json (AD-021). The web app
         generates its TypeScript types from it (AD-022), and CI fails if the committed copy is stale. -->
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../web/openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name quart</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Quart.SharedKernel\Quart.SharedKernel.csproj" />
    <ProjectReference Include="..\Modules\Quart.Modules.Identity\Quart.Modules.Identity.csproj" />
    <ProjectReference Include="..\Modules\Quart.Modules.Workplaces\Quart.Modules.Workplaces.csproj" />
    <ProjectReference Include="..\Modules\Quart.Modules.Scheduling\Quart.Modules.Scheduling.csproj" />
    <ProjectReference Include="..\Modules\Quart.Modules.Marketplace\Quart.Modules.Marketplace.csproj" />
    <ProjectReference Include="..\Modules\Quart.Modules.Announcements\Quart.Modules.Announcements.csproj" />
    <ProjectReference Include="..\Modules\Quart.Modules.Files\Quart.Modules.Files.csproj" />
    <ProjectReference Include="..\Modules\Quart.Modules.Notifications\Quart.Modules.Notifications.csproj" />
    <ProjectReference Include="..\Modules\Quart.Modules.Jobs\Quart.Modules.Jobs.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NodaTime" />
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>
</Project>
